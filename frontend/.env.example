# Frontend Environment Variables - Example
# Copy to .env.local and customize for your backend

# For local development (dev server)
# VITE_API_BASE=http://localhost:5000/api/v1

# For Docker deployment
# VITE_API_BASE=http://localhost/api/v1

# For Netlify/production
# VITE_API_BASE=https://your-api-domain.com/api/v1
