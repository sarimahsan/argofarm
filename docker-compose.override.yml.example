# This file is used for local development overrides
# Copy to docker-compose.override.yml to use

version: '3.8'

services:
  backend:
    # Enable hot reload for development
    volumes:
      - ./backend:/app
      - /app/__pycache__
    environment:
      FLASK_ENV: development
      FLASK_DEBUG: 1
    ports:
      - "5000:5000"

  frontend:
    # Enable hot reload for Vite development
    environment:
      VITE_DEV_SERVER: "true"
    ports:
      - "3000:80"

  db:
    # Enable MySQL logging for development
    command: --log-error=/var/log/mysql/error.log
    ports:
      - "3306:3306"
