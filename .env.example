# ==========================================
# ArgoFarm Docker Compose Environment Setup
# ==========================================
# Copy this file to .env and adjust values as needed

# ==========================================
# Database Configuration
# ==========================================
DB_HOST=db
DB_PORT=3306
DB_NAME=argofarm
DB_USER=argofarm
DB_PASSWORD=argofarm123
DB_ROOT_PASSWORD=root
DATABASE_URL=mysql://argofarm:argofarm123@db:3306/argofarm

# ==========================================
# Flask Backend Configuration
# ==========================================
FLASK_ENV=production
FLASK_APP=app.py
FLASK_DEBUG=0
BACKEND_PORT=5000

# JWT and Security
JWT_SECRET=your-super-secret-key-change-this-in-production-12345
JWT_EXPIRY_DAYS=7

# Logging
LOG_LEVEL=INFO

# ==========================================
# Frontend Configuration
# ==========================================
FRONTEND_PORT=3000
VITE_API_BASE=http://localhost/api
VITE_API_URL=http://localhost/api

# ==========================================
# Nginx Configuration
# ==========================================
NGINX_PORT=80
NGINX_SSL_PORT=443

# ==========================================
# Volumes and File Paths
# ==========================================
UPLOAD_FOLDER=/app/static/uploads
UPLOAD_MAX_SIZE=104857600

# ==========================================
# ML Model Configuration
# ==========================================
ML_MODEL_PATH=/app/ai_models
ML_CACHE_DIR=/app/cache

# ==========================================
# External APIs
# ==========================================
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Email Configuration (if used)
# ==========================================
EMAIL_PROVIDER=gmail
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password

# ==========================================
# Application Settings
# ==========================================
APP_DEBUG=false
APP_ENV=production
CORS_ORIGIN=*
